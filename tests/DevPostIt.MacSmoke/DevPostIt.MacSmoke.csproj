<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\DevPostIt.Desktop\DevPostIt.Desktop.csproj" />
    <!-- 앱 파일을 그대로 써서 실제 창과 웹뷰를 시험합니다. 시작 코드만 시험용으로 바꿉니다. -->
    <Compile Include="..\..\src\DevPostIt.Mac\*.cs" Exclude="..\..\src\DevPostIt.Mac\Main.cs;..\..\src\DevPostIt.Mac\AppDelegate.cs" LinkBase="App" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <ApplicationId>io.github.fharenheit.devpostit.smoke</ApplicationId>
    <ApplicationTitle>DevPostIt Smoke</ApplicationTitle>
    <!-- 저장 코드는 리플렉션 기반 JSON을 쓰므로 어셈블리를 잘라 내지 않습니다. -->
    <LinkMode>None</LinkMode>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <Import Project="..\..\src\DevPostIt.Mac\EditorWeb.targets" />

</Project>
