<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DevPostIt.Desktop\DevPostIt.Desktop.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <ApplicationId>io.github.fharenheit.devpostit</ApplicationId>
    <ApplicationTitle>DevPostIt</ApplicationTitle>
    <ApplicationDisplayVersion>0.7.0</ApplicationDisplayVersion>
    <ApplicationVersion>0.7.0</ApplicationVersion>
    <!-- 저장 코드는 리플렉션 기반 JSON을 쓰므로 어셈블리를 잘라 내지 않습니다. -->
    <LinkMode>None</LinkMode>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <Import Project="EditorWeb.targets" />

</Project>
